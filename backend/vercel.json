{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "functions": {
    "config/wsgi.py": {
      "maxDuration": 60,
      "includeFiles": "{.vercel-demo/template.sqlite3,school_app/demo_ui/templates/**}",
      "excludeFiles": "{.venv/**,venv/**,tests/**,**/__pycache__/**,*.md,db.sqlite3,private_media/**,private_exports/**,staticfiles/**}"
    }
  }
}
