# Reference only: Django does not automatically load this file.
# Set these environment variables in your terminal before running manage.py.
DJANGO_SECRET_KEY=replace-with-your-own-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# DJANGO_DB_PATH defaults to backend/db.sqlite3
QR_ENABLED=false
VISION_FACE_MAX_DISTANCE=55
VISION_FACE_MIN_MARGIN=10
VISION_MIN_SHARPNESS=50
# VISION_UNIFORM_HSV is a JSON object with SHIRT/SPORTS HSV bands; see settings.py.
# Vercel: set DJANGO_SECRET_KEY and a strong DEMO_PASSWORD in the dashboard.
# VERCEL=1 is supplied by the platform; do not enable it for ordinary local DB work.
# Enrollment total defaults to 15 MiB locally / 3 MiB on Vercel.
