# Reference only: Django does not automatically load this file.
# Set these environment variables in your terminal before running manage.py.
DJANGO_SECRET_KEY=replace-with-your-own-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# DJANGO_DB_PATH defaults to backend/db.sqlite3
QR_ENABLED=false
VISION_FACE_MIN_COSINE=0.45
VISION_FACE_MIN_COSINE_MARGIN=0.10
VISION_MIN_SHARPNESS=50
# VISION_UNIFORM_HSV is a JSON object with SHIRT/SPORTS HSV bands; see settings.py.
# Vercel: set DJANGO_SECRET_KEY and a strong DEMO_PASSWORD in the dashboard.
# Optional shared PostgreSQL: DATABASE_URL from Neon/Vercel integration (keep secret).
# Requires operator migrate/seed before serving. Never set DJANGO_DB_PATH in
# production with DATABASE_URL: an explicit SQLite path overrides it for builds.
# VERCEL=1 is supplied by the platform; do not enable it for ordinary local DB work.
# Enrollment total defaults to 64 MiB locally / 3 MiB on Vercel (after UI optimization).
# UI accepts originals up to 32 MiB/120 MP; local enrollment API accepts 16 MiB/64 MP per file.
# YuNet/SFace FP32 models: run manage.py prepare_vision_models before recognition.
# VISION_MODEL_DIR optionally overrides the verified model directory; see settings.py.
# Model key sface-2021dec-fp32; old LBPH samples require enrollment again.
